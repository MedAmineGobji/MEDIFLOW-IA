# Backend environment variables
# Aligne la DB du backend avec la configuration racine (.env) => mediflowai
DATABASE_URL="postgresql://postgres:password@localhost:5432/mediflowai"
PORT=5000
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# OpenAI Configuration
OPENAI_API_KEY="your-openai-api-key-here"
USE_AI_ANALYSIS="false"  # Mettre à "true" pour activer l'analyse IA
